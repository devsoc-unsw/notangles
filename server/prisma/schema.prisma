generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                String        @id @default(cuid(2)) @db.VarChar(30)
  isGuest           Boolean       @default(true)
  firstName         String
  lastName          String
  profilePictureUrl String?
  createdAt         DateTime      @default(now())
  lastLogin         DateTime      @default(now())
  authProvider      AuthProvider?
  authSubject       String?       @db.VarChar(100)
  settings          Settings?
  timetables        Timetable[]

  @@unique([authProvider, authSubject])
  @@map("user")
}

model Settings {
  userId                     String  @unique
  preferredTheme             String  @default("Classic")
  hideFullClasses            Boolean @default(false)
  hideClassInfo              Boolean @default(false)
  unscheduleClassesByDefault Boolean @default(true)
  hideExamClasses            Boolean @default(false)
  convertToLocalTimezone     Boolean @default(false)
  is12HourMode               Boolean @default(true)
  isDarkMode                 Boolean @default(false)
  isSquareEdges              Boolean @default(false)
  user                       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Timetable {
  userId  String
  id      String   @id @default(uuid())
  name    String
  year    Int
  term    String
  primary Boolean  @default(false)
  courses Course[]
  events  Event[]
  User    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timetable")
}

model Course {
  id              String    @id @default(uuid())
  timetableId     String
  courseId        String
  selectedClasses String[]
  colour          String
  timetable       Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@map("course")
}

model Event {
  id          String    @id @default(uuid())
  timetableId String
  title       String
  location    String?
  description String?
  colour      String
  dayOfWeek   Int
  start       Int
  end         Int
  type        EventType
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@map("event")
}

enum AuthProvider {
  GOOGLE
  ZID
  GITHUB
}

enum EventType {
  CUSTOM
  TUTORING
}
