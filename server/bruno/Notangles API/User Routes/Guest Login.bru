meta {
  name: Guest Login
  type: http
  seq: 1
}

get {
  url: {{HostURL}}/auth/login/guest
  body: none
  auth: none
}

script:post-response {
  const sessionCookie = res.getHeader('set-cookie')
  bru.setEnvVar("Session_Cookie", sessionCookie[0].split(';')[0]);
  
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: false
  maxRedirects: 5
}
